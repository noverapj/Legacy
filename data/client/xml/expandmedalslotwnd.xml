                   ItemHSize   = "21"
                   ItemMaxPage = "5"
                   FontSize    = "0.65f" />

		<!--////////////////////////// scroll /////////////////////////////////////////////-->
		<Window ClassName="ioScroll" Id="1000">
			<Size X="182" Y="7" Width="15" Height="105" />
			<Style>IWS_PROCESS</Style>
			<ExStyle>IWS_EX_VSCROLL</ExStyle>
			<Imagery>
				<DefaultFrameImagery Templete="scrollbar_back">
					<Area X="5" Y="10" Width="5" Height="85"/>
				</DefaultFrameImagery>
			</Imagery>
			<ExtraInfo PageRange="1" StartTime="500" CurTime ="100"/>

			<Window ClassName="ioButton" Id="1">
				<Size X="0" Y="0" Width="15" Height="10" />
				<Imagery>
					<Image Type="Normal" Imageset="BaseImage001" Image="scrollbar_arrow_down" >
						<Area X="3" Y="0" Reverse="Vert"/>
					</Image>
					<Image Type="Over" Imageset="BaseImage001" Image="scrollbar_arrow_down" >
						<Area X="3" Y="0" Reverse="Vert"/>
					</Image>
					<Image Type="Push" Imageset="BaseImage001" Image="scrollbar_arrow_down" >
						<Area X="3" Y="0" Reverse="Vert"/>
					</Image>
				</Imagery>
				<ExtraInfo OverSound = "interface/public_mouseover_00.wav" 
				           ClickSound = "interface/public_mouseclick_00.wav"/>					
			</Window>
			<Window ClassName="ioButton" Id="2">
				<Size X="0" Y="200" Width="15" Height="10" />
				<Imagery>
					<Image Type="Normal" Imageset="BaseImage001" Image="scrollbar_arrow_down" >
						<Area X="3" Y="0"/>
					</Image>
					<Image Type="Over" Imageset="BaseImage001" Image="scrollbar_arrow_down" >
						<Area X="3" Y="0"/>
					</Image>
					<Image Type="Push" Imageset="BaseImage001" Image="scrollbar_arrow_down" >
						<Area X="3" Y="0"/>
					</Image>
				</Imagery>
				<ExtraInfo OverSound = "interface/public_mouseover_00.wav" 
				           ClickSound = "interface/public_mouseclick_00.wav"/>					
			</Window>
			<Window ClassName="ioSlide" Id="3">
				<Size X="0" Y="10" Width="15" Height="30" />
				<DragRect Left="0" Top="0" Right="15" Bottom="30" />
				<ExStyle>IWS_EX_NOTIFY_MOVED</ExStyle>
				<Style>IWS_CANMOVE</Style>
				<Imagery>
					<DefaultFrameImagery Templete="scrollbar_drag">
