	<!-- 클레스 리스트 -->
	<Window ClassName="NewShopPullDownWnd" Id="101">
		<Size X="0" Y="0" Width="204" Height="21" />
		<Style>IWS_START_HIDE|IWS_PROCESS|IWS_TOPMOST</Style>
