			<Image Type="OverLine" Imageset="BaseImage001" Image="strip_gray_on" >
				<Area X="0" Y="0" Width="70" Height="21" HorzAlign="Stretch" VertAlign="Stretch" />
			</Image>
		</Imagery>
		<ExtraInfo StartHGap   = "8" 
