#include "Version.h"

#ifdef SHIPPING
	IDR_MAINFRAME    ICON       "res\\Shipping.ico"
	#define DESCRIPTION         "Novera Client"
#define PRODUCTVER           0,FILEVER,0,1
#define STRPRODUCTVER        "0,FILEVER,0,1"
#else
	IDR_MAINFRAME    ICON       "res\\Admin.ico"
	#define DESCRIPTION         "Novera Client Admin"
#define PRODUCTVER           0,FILEVER,0,1
#define STRPRODUCTVER        "0,FILEVER,0,1"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,FILEVER,0,1
 PRODUCTVERSION PRODUCTVER
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
			VALUE "FileDescription", DESCRIPTION
     		VALUE "CompanyName", "NOVERA OSS"
			VALUE "ProductName", "Novera Client"
            VALUE "FileVersion", STRFILEVER
            VALUE "LegalCopyright", "NOVERA OSS"
            VALUE "ProductVersion", STRFILEVER
			VALUE "InternalName", STRINTERNALNAME
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END















