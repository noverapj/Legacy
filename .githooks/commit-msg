#!/bin/sh

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

PATTERN='^(feat|fix|refactor|perf|docs|test|build|chore|revert)\((client|engine|gamesvr|mainsvr|billingsvr|dbagent|filewritesvr|loginsvr|relaysvr|launcher|tools|sql|solution|tooling|ci|deps|readme)\): .+'

if echo "$COMMIT_MSG" | grep -Eq "$PATTERN"; then
    exit 0
fi

echo ""
echo "ERROR: Invalid commit message."
echo "Expected: type(scope): description"
echo ""
echo "Valid types:"
echo "  feat fix refactor perf docs test build chore revert"
echo ""
echo "Examples:"
echo "  feat(client): add new hero skill handler"
echo "  fix(gamesvr): prevent duplicate room join"
echo "  fix(engine): preserve binary ABI for RenderSkip"
echo "  build(solution): update Visual Studio projects"
echo "  chore(ci): add commit message hook"
echo "  docs(readme): update build instructions"
echo ""

exit 1